<label class="motion-control" data-motion-controls hidden>
  <input type="checkbox" data-motion-toggle checked />
  动态效果
</label>

<script>
  import { motionAllowed, setMotionEnabled } from '@/scripts/motion-state';
  import { initPageTitles } from '@/scripts/typewriter';
  const toggle = document.querySelector<HTMLInputElement>('[data-motion-toggle]');
  const wind = document.querySelector<HTMLButtonElement>('[data-wind-toggle]');
  let engine: ReturnType<typeof import('@/scripts/petals').createPetalWind> | undefined;
  let pending = 0;
  let loading = false;
  let generation = 0;
  function resetWind() {
    generation++;
    pending = 0;
    loading = false;
    engine?.stop();
    engine = undefined;
  }
  function sync() {
    const allowed = motionAllowed();
    if (toggle) toggle.checked = allowed;
    if (wind) {
      wind.disabled = !allowed;
      wind.title = allowed ? 'Mysterious wind' : '动态效果已关闭';
    }
    if (!allowed) resetWind();
  }
  document.querySelector<HTMLElement>('[data-motion-controls]')?.removeAttribute('hidden');
  wind?.removeAttribute('hidden');
  toggle?.addEventListener('change', () => { setMotionEnabled(toggle.checked); sync(); });
  async function summonWind() {
    if (!motionAllowed() || document.hidden) return;
    if (engine) { engine.gust(); return; }
    pending = Math.min(4, pending + 1);
    if (loading) return;
    loading = true;
    const ticket = ++generation;
    try {
      const { createPetalWind } = await import('@/scripts/petals');
      if (ticket !== generation || !motionAllowed() || document.hidden) return;
      loading = false;
      engine = createPetalWind(() => { engine = undefined; });
      const count = pending;
      pending = 0;
      for (let i = 0; i < count; i++) engine?.gust();
    } catch { if (ticket === generation) resetWind(); }
  }
  wind?.addEventListener('click', () => void summonWind());
  window.addEventListener('hydroxy:wind', () => void summonWind());
  window.addEventListener('hydroxy:motion-change', sync);
  document.addEventListener('visibilitychange', () => { if (document.hidden) resetWind(); });
  window.addEventListener('pagehide', resetWind);
  sync();
  initPageTitles();
</script>
