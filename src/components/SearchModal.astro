---
const isPage = Astro.props.isPage ?? false;
---

{isPage ? <section class="search-surface pixel-panel" data-search-surface><form class="search-form" data-search-form><input class="search-input" data-search-input type="search" name="q" autocomplete="off" placeholder="search Hydroxy Wiki" /><button class="text-button" type="submit">GO</button></form><div class="search-results" data-search-results></div></section> : <dialog class="search-modal" data-search-modal aria-label="Search Hydroxy Wiki"><section class="search-surface pixel-panel" data-search-surface><form class="search-form" data-search-form><input class="search-input" data-search-input type="search" name="q" autocomplete="off" placeholder="search Hydroxy Wiki" /><button class="text-button" type="submit">GO</button></form><div class="search-results" data-search-results></div></section></dialog>}

<script>
  type SearchResult = {
    entity_kind: 'learn' | 'essay' | 'anime' | 'gallery';
    path: string;
    title: string;
    excerpt?: string;
  };

  const surfaces = Array.from(document.querySelectorAll<HTMLElement>('[data-search-surface]'));
  const entities: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' };
  const escapeHtml = (value: unknown) => String(value).replace(/[&<>'"]/g, (character) => entities[character] ?? character);
  const hrefFor = (result: SearchResult) => result.entity_kind === 'learn' ? '/learn/' + result.path + '/' : result.entity_kind === 'essay' ? '/life/essays/' + result.path + '/' : result.entity_kind === 'anime' ? '/life/anime/' : '/life/gallery/';
  const message = (surface: HTMLElement, value: string) => {
    const area = surface.querySelector<HTMLElement>('[data-search-results]');
    if (area) area.innerHTML = '<p class="search-result">' + value + '</p>';
  };

  async function runSearch(surface: HTMLElement, query: string) {
    if (!query.trim()) return message(surface, 'READY');
    message(surface, 'SEARCHING...');
    try {
      const response = await fetch('/api/search?q=' + encodeURIComponent(query.trim()), { headers: { Accept: 'application/json' } });
      const payload = await response.json() as { results?: SearchResult[] };
      const area = surface.querySelector<HTMLElement>('[data-search-results]');
      if (!area) return;
      const results = Array.isArray(payload.results) ? payload.results : [];
      area.innerHTML = results.length
        ? results.map((result) => '<a class="search-result" href="' + hrefFor(result) + '"><strong>' + escapeHtml(result.title) + '</strong><span>' + escapeHtml(result.excerpt ?? '').replace(/&lt;mark&gt;/g, '<mark>').replace(/&lt;\/mark&gt;/g, '</mark>') + '</span></a>').join('')
        : '<p class="search-result">NO MATCH</p>';
    } catch {
      message(surface, 'SEARCH UNAVAILABLE');
    }
  }

  surfaces.forEach((surface) => {
    const form = surface.querySelector<HTMLFormElement>('[data-search-form]');
    const input = surface.querySelector<HTMLInputElement>('[data-search-input]');
    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial && input) {
      input.value = initial;
      void runSearch(surface, initial);
    } else {
      message(surface, 'READY');
    }
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (input) void runSearch(surface, input.value);
    });
  });

  const modal = document.querySelector<HTMLDialogElement>('[data-search-modal]');
  document.querySelectorAll<HTMLButtonElement>('[data-search-open]').forEach((button) => {
    button.addEventListener('click', () => {
      if (modal) {
        modal.showModal();
        modal.querySelector<HTMLInputElement>('input')?.focus();
      }
    });
  });

  window.addEventListener('hydroxy:search', (event) => {
    const detail = event instanceof CustomEvent ? event.detail as { query?: unknown } : undefined;
    const query = typeof detail?.query === 'string' ? detail.query : '';
    if (!modal) {
      window.location.href = '/search/?q=' + encodeURIComponent(query);
      return;
    }
    modal.showModal();
    const input = modal.querySelector<HTMLInputElement>('[data-search-input]');
    if (input) {
      input.value = query;
      input.focus();
    }
    const surface = modal.querySelector<HTMLElement>('[data-search-surface]');
    if (surface) void runSearch(surface, query);
  });

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal?.open) modal.close();
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      modal?.showModal();
    }
  });
</script>