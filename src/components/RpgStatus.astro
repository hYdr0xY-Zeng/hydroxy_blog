---
import { SITE } from '@/utils/site';

const { learnCount = 0, essayCount = 0, tagCount = 0 } = Astro.props;
---

<section class="rpg-status pixel-panel" aria-labelledby="status-title">
  <div class="rpg-status__top">
    <div>
      <p class="section-kicker">Hydroxy Wiki</p>
      <h1 id="status-title" class="section-title">Personal Knowledge Console</h1>
      <p class="section-copy">
        ？！羟羟！？的个人 Wiki，用来存储学习笔记、技术文章和生活切片。
      </p>
      <nav class="status-social" aria-label="Social profiles">
        {SITE.social.map((item) => (
          <a
            class="text-button status-social__link"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open Hydroxy ${item.label} profile`}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="rpg-avatar">
      <img src="/images/profile/avatar.jpg" alt="Hydroxy avatar" width="96" height="96" />
    </div>
  </div>

  <div class="stat-grid">
    <div class="stat">
      <span>Learn Nodes</span>
      <strong>{learnCount}</strong>
    </div>
    <div class="stat">
      <span>Essays</span>
      <strong>{essayCount}</strong>
    </div>
    <div class="stat">
      <span>Tags</span>
      <strong>{tagCount}</strong>
    </div>
  </div>
</section>
