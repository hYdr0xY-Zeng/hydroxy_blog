---
import type { LearnNode } from '@/lib/cms';

type Props = {
  nodes: LearnNode[];
  activeSlug?: string;
};

const { nodes, activeSlug = '' } = Astro.props;

function isOpen(node: LearnNode) {
  return activeSlug === node.path || activeSlug.startsWith(`${node.path}/`);
}
---

<ul class="tree-list">
  {nodes.map((node) => (
    <li>
      <a class="tree-link" href={node.href} aria-current={activeSlug === node.path ? 'page' : undefined}>
        <span class="tree-link__icon" aria-hidden="true">{node.children.length ? (isOpen(node) ? '[-]' : '[+]') : '[*]'}</span>
        <span>{node.label}</span>
      </a>
      {node.children.length > 0 && isOpen(node) && <Astro.self nodes={node.children} activeSlug={activeSlug} />}
    </li>
  ))}
</ul>
