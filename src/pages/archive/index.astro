---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { documentHref, listDocuments } from '@/lib/cms';
import { formatDate } from '@/utils/site';

const entries = await listDocuments(Astro.locals);
---

<BaseLayout title="Archive" description="Hydroxy Wiki 的公开内容归档。">
  <header class="page-hero pixel-panel"><p class="section-kicker">/archive</p><h1 class="section-title">Archive</h1><p class="section-copy">全部公开学习文章和生活随笔，按发布时间倒序排列。</p></header>
  <section class="content-card"><div class="archive-list">{entries.map((entry) => <div class="archive-row"><time datetime={entry.published_at ?? entry.updated_at}>{formatDate(entry.published_at ?? entry.updated_at)}</time><a href={documentHref(entry)}>{entry.title}</a></div>)}</div></section>
</BaseLayout>
