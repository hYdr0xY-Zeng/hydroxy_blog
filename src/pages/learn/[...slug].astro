---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import WikiTree from '@/components/WikiTree.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import ArticleEngagement from '@/components/ArticleEngagement.astro';
import { getDocument, getEngagementSummary, getLearnTree, getRedirect } from '@/lib/cms';
import { renderMarkdown } from '@/lib/markdown';
import { buildCrumbs } from '@/utils/wiki';
import { formatDate } from '@/utils/site';

const slug = Astro.params.slug ?? '';
const [tree, entry] = await Promise.all([getLearnTree(Astro.locals), getDocument(Astro.locals, 'learn', slug)]);
const node = tree.byPath.get(slug);
if (!node) {
  const redirect = await getRedirect(Astro.locals, Astro.url.pathname);
  if (redirect) return Astro.redirect(redirect.to_path, 301);
  return Astro.redirect('/learn/');
}
const isDirectory = node.node_type === 'directory';
const rendered = entry && (!isDirectory || entry.body_markdown.trim()) ? await renderMarkdown(entry.body_markdown) : null;
const engagement = entry && !isDirectory ? await getEngagementSummary(Astro.locals, entry.id) : null;
const crumbs = buildCrumbs(slug);
---

<BaseLayout title={isDirectory ? node.label : entry?.title ?? node.label} description={entry?.description ?? `Hydroxy Wiki directory ${node.label}`}>
  <div class="learn-layout">
    <WikiTree tree={tree.roots} activeSlug={slug} />
    <section class="learn-content">
      <nav aria-label="Breadcrumb"><ol class="crumbs">{crumbs.map((crumb, index) => <li><a href={crumb.href}>{crumb.label}</a>{index < crumbs.length - 1 ? ' /' : ''}</li>)}</ol></nav>
      {isDirectory ? <>
        <header class="directory-hero pixel-panel"><p class="section-kicker">/learn/{slug}</p><h1 class="section-title">{node.label}</h1><p class="section-copy">{entry?.description || '继续沿着目录树进入子目录或文章。'}</p></header>
        {rendered && <div class="article-shell"><article class="article-body pixel-panel prose" set:html={rendered.html} /><TableOfContents headings={rendered.headings} /></div>}
        {node.children.length > 0 && <section class="directory-children"><h2>CHILD NODES</h2><div class="directory-grid">{node.children.map((child) => <a class="article-card" href={child.href}><h3>{child.node_type === 'directory' ? '[DIR]' : '[MD]'} {child.label}</h3><p>{child.entry?.description || (child.node_type === 'directory' ? `${child.children.length} child nodes` : '')}</p></a>)}</div></section>}
      </> : entry && <>
        <header class="article-hero pixel-panel"><p class="section-kicker">/learn/{entry.path}</p><h1 class="section-title">{entry.title}</h1><p class="section-copy">{entry.description}</p><div class="article-meta"><span>{formatDate(entry.published_at ?? entry.updated_at)}</span>{entry.tags.map((tag) => <span>{tag}</span>)}{engagement && <ArticleEngagement documentId={entry.id} engagement={engagement} placement="meta" />}</div></header>
        <div class="article-shell"><article class="article-body pixel-panel prose" set:html={rendered?.html} /><TableOfContents headings={rendered?.headings ?? []} /></div>
        {engagement && <ArticleEngagement documentId={entry.id} engagement={engagement} placement="action" />}
      </>}
    </section>
  </div>
</BaseLayout>
