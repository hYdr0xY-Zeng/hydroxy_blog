---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import anime from '@/data/anime.json';
import gallery from '@/data/gallery.json';
import { entryHref } from '@/utils/content';
import { isPublished, sortEntriesByDate } from '@/utils/wiki';
import { formatDate } from '@/utils/site';

const essays = sortEntriesByDate((await getCollection('essays')).filter(isPublished));
---

<BaseLayout title="Life" description="Hydroxy Wiki 的生活页：个人简介、追番、随笔和图片。">
  <header class="page-hero pixel-panel">
    <p class="section-kicker">/life</p>
    <h1 class="section-title">Life Pages</h1>
    <p class="section-copy">技术之外的个人页。这里放简介、追番、随笔和图片，保持和学习区分开。</p>
  </header>

  <div class="life-grid">
    <section class="content-card">
      <h2>Profile</h2>
      <p class="section-copy">
        Hydroxy。长期维护这个 Wiki，记录学习路径、技术实验和一些生活里的低频信号。
      </p>
    </section>

    <section class="content-card">
      <h2>Essays</h2>
      <ul class="article-list">
        {essays.slice(0, 5).map((entry) => (
          <li>
            <a class="article-link" href={entryHref(entry)}>
              <strong>{entry.data.title}</strong>
              <span>{formatDate(entry.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="content-card life-wide">
      <h2>Anime Log</h2>
      <div class="anime-grid">
        {anime.map((item) => (
          <article class="media-card">
            <img src={item.cover} alt="" loading="lazy" />
            <div class="media-card__body">
              <h3>{item.title}</h3>
              <p>{item.status} / {item.score}/10</p>
              <p>{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-card life-wide">
      <h2>Gallery</h2>
      <div class="gallery-grid">
        {gallery.map((item) => (
          <article class="media-card">
            <img src={item.src} alt={item.alt} loading="lazy" />
            <div class="media-card__body">
              <h3>{item.title}</h3>
              <p>{item.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
