---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import anime from '@/data/anime.json';
import gallery from '@/data/gallery.json';
import { isPublished } from '@/utils/wiki';

const essays = (await getCollection('essays')).filter(isPublished);

const gates = [
  {
    title: 'Anime Log',
    href: '/life/anime/',
    count: anime.length,
    copy: '用密集列表记录看过和正在看的番剧，适合长期维护大列表。'
  },
  {
    title: 'Essays',
    href: '/life/essays/',
    count: essays.length,
    copy: '技术之外的随笔、低频想法和生活片段。'
  },
  {
    title: 'Gallery',
    href: '/life/gallery/',
    count: gallery.length,
    copy: '按原比例摆放图片，只保留图片名，轻量浏览。'
  }
];
---

<BaseLayout title="Life" description="Hydroxy Wiki 的生活页入口：个人简介、追番、随笔和图片。">
  <header class="page-hero pixel-panel">
    <p class="section-kicker">/life</p>
    <h1 class="section-title">Life Pages</h1>
    <p class="section-copy">技术之外的个人页。这里保留简介，并把追番、随笔和图片拆成独立子界面。</p>
  </header>

  <div class="life-hub">
    <section class="content-card profile-card">
      <h2>Profile</h2>
      <p class="section-copy">
        Hydroxy。长期维护这个 Wiki，记录学习路径、技术实验和一些生活里的低频信号。
      </p>
    </section>

    <section class="life-gates" aria-label="Life sections">
      {gates.map((gate) => (
        <a class="life-gate article-card" href={gate.href}>
          <span class="life-gate__count">{gate.count}</span>
          <h2>{gate.title}</h2>
          <p>{gate.copy}</p>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>
