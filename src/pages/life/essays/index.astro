---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import { documentHref, listDocuments } from '@/lib/cms';
import { formatDate } from '@/utils/site';

const essays = await listDocuments(Astro.locals, { kind: 'essay' });
---

<BaseLayout title="Essays" description="Hydroxy Wiki 的生活随笔列表。">
  <header class="page-hero pixel-panel"><p class="section-kicker">/life/essays</p><h1 class="section-title">Essays</h1><p class="section-copy">随便写些什么。</p></header>
  <section class="content-card"><ul class="article-list">{essays.map((entry) => <li><a class="article-link" href={documentHref(entry)}><strong>{entry.title}</strong><span>{formatDate(entry.published_at ?? entry.updated_at)} / {entry.mood || 'quiet'}</span></a></li>)}</ul></section>
</BaseLayout>
