---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Pagination from '@/components/Pagination.astro';
import { galleryImage, listGallery } from '@/lib/cms';
import { pageHref } from '@/utils/pagination';

const routePage = Astro.params.page?.match(/^page\/(\d+)$/)?.[1];
const current = await listGallery(Astro.locals, routePage ? Number(routePage) : 1, 30);
const pages = Array.from({ length: current.totalPages }, (_, index) => ({ href: pageHref('/life/gallery/', index + 1), label: String(index + 1), current: index + 1 === current.currentPage }));
---

<BaseLayout title="Gallery" description="Hydroxy Wiki 的图片页。">
  <header class="page-hero pixel-panel"><p class="section-kicker">/life/gallery</p><h1 class="section-title">Gallery</h1><p class="section-copy">当前第 {current.currentPage} / {current.totalPages} 页，共 {current.totalItems} 张。</p></header>
  <section class="gallery-masonry" aria-label="Gallery images">{current.items.map((item) => <figure class="gallery-tile"><img src={galleryImage(item)} alt={item.alt || item.title} loading="lazy" /><figcaption>{item.title}</figcaption></figure>)}</section>
  <Pagination label="Gallery pagination" previousHref={current.currentPage > 1 ? pageHref('/life/gallery/', current.currentPage - 1) : undefined} nextHref={current.currentPage < current.totalPages ? pageHref('/life/gallery/', current.currentPage + 1) : undefined} pages={pages} />
</BaseLayout>
