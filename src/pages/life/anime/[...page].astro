---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Pagination from '@/components/Pagination.astro';
import { animeCover, listAnime } from '@/lib/cms';
import { pageHref } from '@/utils/pagination';

const routePage = Astro.params.page?.match(/^page\/(\d+)$/)?.[1];
const current = await listAnime(Astro.locals, routePage ? Number(routePage) : 1, 20);
const pages = Array.from({ length: current.totalPages }, (_, index) => ({ href: pageHref('/life/anime/', index + 1), label: String(index + 1), current: index + 1 === current.currentPage }));
---

<BaseLayout title="Anime Log" description="Hydroxy Wiki 的追番记录。">
  <header class="page-hero pixel-panel"><p class="section-kicker">/life/anime</p><h1 class="section-title">Anime Log</h1><p class="section-copy">这里是 Qiangumi Desu!。当前第 {current.currentPage} / {current.totalPages} 页，共 {current.totalItems} 部。</p></header>
  <section class="content-card list-surface"><div class="anime-list">{current.items.map((item) => <article class="anime-row"><img src={animeCover(item)} alt="" loading="lazy" /><div class="anime-row__body"><div class="anime-row__title"><h2>{item.cn_title || item.title}</h2>{item.cn_title && <span>{item.title}</span>}</div><div class="anime-row__meta">{item.year && <span>{item.year}</span>}{item.status && <span>{item.status}</span>}{typeof item.score === 'number' && <span>{item.score}/10</span>}</div>{item.note && <p>{item.note}</p>}</div></article>)}</div></section>
  <Pagination label="Anime pagination" previousHref={current.currentPage > 1 ? pageHref('/life/anime/', current.currentPage - 1) : undefined} nextHref={current.currentPage < current.totalPages ? pageHref('/life/anime/', current.currentPage + 1) : undefined} pages={pages} />
</BaseLayout>
