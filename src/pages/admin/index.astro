---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
import AdminLifePanel from '@/components/AdminLifePanel.astro';
import { requireAdmin } from '@/lib/auth';
import { getDocument, listAnime, listDocuments, listGallery, listLearnDirectories, listMediaAssets } from '@/lib/cms';
import { mediaHref } from '@/lib/runtime';

const identity = await requireAdmin(Astro.request, Astro.locals);
if (identity instanceof Response) return identity;
const requestedPage = (key: string) => {
  const value = Number(Astro.url.searchParams.get(key));
  return Number.isSafeInteger(value) && value > 0 ? value : 1;
};
const animeQuery = Astro.url.searchParams.get('anime_q') ?? '';
const galleryQuery = Astro.url.searchParams.get('gallery_q') ?? '';
const [learn, essays, profile, anime, gallery, directories, media] = await Promise.all([
  listDocuments(Astro.locals, { kind: 'learn', includeUnpublished: true }),
  listDocuments(Astro.locals, { kind: 'essay', includeUnpublished: true }),
  getDocument(Astro.locals, 'profile', 'home', true),
  listAnime(Astro.locals, requestedPage('anime_page'), 25, true, animeQuery),
  listGallery(Astro.locals, requestedPage('gallery_page'), 25, true, galleryQuery),
  listLearnDirectories(Astro.locals),
  listMediaAssets(Astro.locals)
]);
const documents = [...learn, ...essays, ...(profile ? [profile] : [])];
---

<BaseLayout title="Admin" description="Hydroxy Wiki private editor.">
  <header class="page-hero pixel-panel"><p class="section-kicker">/admin</p><h1 class="section-title">Content Console</h1><p class="section-copy">{identity.email}</p><a class="text-button" href="/api/admin/export">EXPORT</a></header>
  <section class="admin-grid">
    <div class="pixel-panel admin-panel"><div class="admin-panel__head"><h2>Documents</h2><div><a class="text-button" href="/admin/editor/new?kind=learn">NEW LEARN</a><a class="text-button" href="/admin/editor/new?kind=essay">NEW ESSAY</a></div></div><ul class="article-list">{documents.map((document) => <li><a class="article-link" href={`/admin/editor/${document.id}`}><strong>{document.title}</strong><span>{document.kind} / {document.status} / {document.path}</span></a></li>)}</ul></div>
    <div class="pixel-panel admin-panel"><div class="admin-panel__head"><h2>Learn Directories</h2></div><form class="admin-form" data-directory-form><label>Parent<select name="parent_path"><option value="">/learn</option>{directories.map((directory) => <option value={directory.path}>{'-- '.repeat(directory.depth)}{directory.label} / {directory.path}</option>)}</select></label><label>Label<input name="label" placeholder="Computer Science" required /></label><label>Slug<input name="slug" placeholder="computer-science" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /></label><label>Order<input name="sort_order" type="number" value="9999" /></label><button class="text-button">CREATE DIRECTORY</button></form><ul class="article-list">{directories.map((directory) => <li><a class="article-link" href={directory.document_id ? `/admin/editor/${directory.document_id}` : `/admin/editor/new?directory=${encodeURIComponent(directory.path)}`}><strong>{directory.label}</strong><span>/learn/{directory.path} / order {directory.sort_order} / {directory.document_id ? 'EDIT INTRO' : 'ADD INTRO'}</span></a></li>)}</ul></div>
    <div class="pixel-panel admin-panel"><div class="admin-panel__head"><h2>Media</h2></div><form data-media-form class="admin-form"><input type="file" name="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" required /><button class="text-button">UPLOAD</button><output data-media-output></output></form><ul class="admin-media-list">{media.map((asset) => <li><a href={mediaHref(asset.key)} target="_blank" rel="noreferrer"><img src={mediaHref(asset.key)} alt={asset.original_name} loading="lazy" /></a><div><strong>{asset.original_name}</strong><span>{asset.key}</span><span>{Math.ceil(asset.byte_size / 1024)} KiB / {asset.references} reference(s)</span></div><div><button class="icon-button" type="button" title="Copy media URL" aria-label="Copy media URL" data-media-copy={mediaHref(asset.key)}>COPY</button><button class="text-button danger-button" type="button" data-media-delete data-media-key={asset.key} data-media-name={asset.original_name}>DELETE</button></div></li>)}</ul></div>
    <AdminLifePanel kind="anime" result={anime} query={animeQuery} />
    <AdminLifePanel kind="gallery" result={gallery} query={galleryQuery} />
  </section>
  <dialog class="delete-dialog pixel-panel" data-media-delete-dialog><form data-media-delete-form><h2>Delete Media</h2><p>Type <strong data-media-delete-name></strong> to permanently delete this unreferenced file.</p><label>Confirmation<input data-media-delete-confirmation autocomplete="off" /></label><div><button class="text-button" type="button" data-dialog-cancel>CANCEL</button><button class="text-button danger-button" type="submit">DELETE</button></div><output data-media-delete-error aria-live="polite"></output></form></dialog>
</BaseLayout>

<script>
  type ApiPayload = { error?: string; key?: string; ok?: boolean; references?: { type: string; label: string }[] };

  const errorMessage = (error: unknown) => error instanceof Error ? error.message : 'Request failed';
  const post = async (body: unknown) => {
    const response = await fetch('/api/admin/content', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const payload = await response.json() as ApiPayload;
    if (!response.ok) throw new Error(payload.error || 'Save failed');
    return payload;
  };

  const directoryForm = document.querySelector<HTMLFormElement>('[data-directory-form]');
  directoryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const values = new FormData(directoryForm);
    const field = (name: string) => {
      const value = values.get(name);
      return typeof value === 'string' ? value : '';
    };
    try {
      await post({ action: 'saveLearnDirectory', directory: { parent_path: field('parent_path'), label: field('label'), slug: field('slug'), sort_order: Number(field('sort_order')) } });
      window.location.reload();
    } catch (error) {
      alert(errorMessage(error));
    }
  });

  const mediaForm = document.querySelector<HTMLFormElement>('[data-media-form]');
  if (mediaForm) {
    mediaForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const output = mediaForm.querySelector<HTMLOutputElement>('[data-media-output]');
      try {
        const response = await fetch('/api/admin/media', { method: 'POST', body: new FormData(mediaForm) });
        const payload = await response.json() as ApiPayload;
        if (output) output.textContent = payload.key || payload.error || 'Upload failed';
      } catch (error) {
        if (output) output.textContent = errorMessage(error);
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-media-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const href = button.dataset.mediaCopy;
      if (!href) return;
      await navigator.clipboard.writeText(new URL(href, window.location.origin).href);
      button.textContent = 'DONE';
      window.setTimeout(() => { button.textContent = 'COPY'; }, 1200);
    });
  });

  const mediaDialog = document.querySelector<HTMLDialogElement>('[data-media-delete-dialog]');
  mediaDialog?.querySelector<HTMLButtonElement>('[data-dialog-cancel]')?.addEventListener('click', () => mediaDialog.close());
  let mediaDeletion: { key: string; name: string } | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-media-delete]').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.mediaKey;
      const name = button.dataset.mediaName;
      if (!key || !name || !mediaDialog) return;
      mediaDeletion = { key, name };
      const label = mediaDialog.querySelector<HTMLElement>('[data-media-delete-name]');
      const confirmation = mediaDialog.querySelector<HTMLInputElement>('[data-media-delete-confirmation]');
      const output = mediaDialog.querySelector<HTMLOutputElement>('[data-media-delete-error]');
      if (label) label.textContent = name;
      if (confirmation) confirmation.value = '';
      if (output) output.textContent = '';
      mediaDialog.showModal();
    });
  });
  mediaDialog?.querySelector<HTMLFormElement>('[data-media-delete-form]')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!mediaDeletion) return;
    const confirmation = mediaDialog.querySelector<HTMLInputElement>('[data-media-delete-confirmation]')?.value ?? '';
    const output = mediaDialog.querySelector<HTMLOutputElement>('[data-media-delete-error]');
    try {
      const response = await fetch('/api/admin/media/' + mediaDeletion.key.split('/').map(encodeURIComponent).join('/'), { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirmation }) });
      const payload = await response.json() as ApiPayload;
      if (!response.ok || !payload.ok) {
        const references = payload.references?.map((reference) => reference.label).join(', ');
        throw new Error(references ? `${payload.error || 'Delete blocked.'} ${references}` : payload.error || 'Delete failed.');
      }
      window.location.reload();
    } catch (error) {
      if (output) output.textContent = errorMessage(error);
    }
  });
</script>
